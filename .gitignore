# --- Secrets ---
.env
*.env
!.env.example
# Ad-hoc probe/experiment scripts at the repo root. These routinely get a real
# key pasted into them "just to test"; keeping them untracked means a stray
# `git add -A` can never publish one. Committed tooling lives in scripts/.
/test_*.py
/scratch*.py
/scratch*.mjs

# --- Personal data (real name/contact/EEO/salary answers) — keep local only ---
config/candidate.json
config/screening_answers.json
!config/candidate.example.json
!config/screening_answers.example.json

# Timestamped backups written by scripts/harvestSources.mjs --apply
config/*.bak

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# --- Local data & generated artifacts ---
.tmp/
data/*.db
data/*.db-shm
data/*.db-wal
# Timestamped backups written by scripts/repairJobUrls.mjs --apply (contains
# the same personal application data as the live DB, so it must never commit)
data/*.db.*.bak
data/found_jobs.json
data/scored_jobs.json
data/queued_jobs.json
data/unknown_date_review.json
data/job_tracker.csv
data/approval_queue.json
data/run_state.json
data/packets/
data/application-state/
resumes/output/*
!resumes/output/.gitkeep
applications/output/*
!applications/output/.gitkeep
logs/*
!logs/.gitkeep
!logs/README.md

# --- Reports (generated output at the repo root ONLY — never src/reports/) ---
/reports/

# --- Playwright ---
playwright-report/
test-results/
.cache/

# --- Browser profile (saved logins/cookies — never commit) ---
.browser-profile/
.browser-profile-*/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace
