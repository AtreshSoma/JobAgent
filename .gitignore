# --- Secrets ---
.env
*.env
!.env.example
# Ad-hoc probe/experiment scripts at the repo root. These routinely get a real
# key pasted into them "just to test"; keeping them untracked means a stray
# `git add -A` can never publish one. Committed tooling lives in scripts/.
/test_*.py
/scratch*.py
/scratch*.mjs

# --- Personal data (real name/contact/EEO/salary answers) — keep local only ---
config/candidate.json
config/screening_answers.json
!config/candidate.example.json
!config/screening_answers.example.json

# Timestamped backups written by scripts/harvestSources.mjs --apply
config/*.bak

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# --- Local data & generated artifacts ---
.tmp/
data/*.db
data/*.db-shm
data/*.db-wal
# Timestamped backups written by scripts/repairJobUrls.mjs --apply (contains
# the same personal application data as the live DB, so it must never commit)
data/*.db.*.bak
# ...and SQLite's sidecars for those backups. `data/*.db-shm` above only covers
# the LIVE database; a backup's sidecars are named `<name>.bak-shm`/`-wal`,
# matched by neither rule, so six files holding the same personal application
# data sat staged-able in `git status` waiting for a `git add -A`.
data/*.bak-shm
data/*.bak-wal
data/found_jobs.json
data/scored_jobs.json
data/queued_jobs.json
data/unknown_date_review.json
data/job_tracker.csv
data/approval_queue.json
data/run_state.json
# Measured per-source discovery durations. A local cache used to schedule the
# slowest sources first — machine- and network-specific, so it is never shared.
data/source_timings.json
# Questions real employers' forms asked that the filler could not answer, with
# the jobs that asked them. Personal, like the answers they lead to.
data/question_queue.json
data/packets/
data/application-state/
resumes/output/*
!resumes/output/.gitkeep
# Timestamped copies the tailoring step writes before touching the master.
# Generated artifacts, not sources.
resumes/base/history/
# THE MASTER RESUME IS PERSONAL DATA, NOT A SOURCE ARTIFACT.
# It was tracked for years because it is the only thing that makes the tailor
# testable — which put a real full name, personal mobile number, personal email,
# LinkedIn handle and a complete 10-year employment history into every clone of
# this repository. `MASTER_RESUME.example.docx` is a synthetic stand-in with the
# same structure; `npm run setup` copies it into place, and the tailor and its
# tests run against it unchanged.
resumes/base/MASTER_RESUME.docx
!resumes/base/MASTER_RESUME.example.docx
# A PDF rendered FROM the master. Derived, regenerated on demand, and a binary
# that would churn on every export.
resumes/base/MASTER_RESUME.pdf
applications/output/*
!applications/output/.gitkeep
logs/*
!logs/.gitkeep
!logs/README.md

# --- Reports (generated output at the repo root ONLY — never src/reports/) ---
/reports/

# --- Playwright ---
playwright-report/
test-results/
.cache/

# --- Browser profile (saved logins/cookies — never commit) ---
.browser-profile/
.browser-profile-*/

# --- Unrelated projects that happen to live under this checkout ---
# `git check-ignore PyProjects` matched nothing, so 34 MB of unrelated work
# (quant trading, stock analysis, a second job-search agent) sat untracked and
# un-ignored: one `git add -A` away from being committed here.
PyProjects/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# Local Claude Code tooling: vendored skills/agents plus `.claude/worktrees/`,
# which holds real git worktrees. A worktree is a checkout, never a thing to
# commit into the repo it belongs to.
.claude/
