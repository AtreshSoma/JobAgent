    {
      "id": "apify-linkedin",
      "adapter": "apify",
      "enabled": true,
      "priority": 2,
      "rateLimitMs": 2000,
      "options": {
        "note": "DISCOVERY via LinkedIn through YOUR OWN Apify account using valig~linkedin-jobs-scraper. PAY-PER-RESULT (~$0.0004/job + ~$0.001/run on the FREE plan) — no monthly rental required. Compliance: official Apify REST API with your token only; no login replay, CAPTCHA solving, or evasion. These searches are set to the LAST 24 HOURS (datePosted r86400) to surface brand-new postings. Other datePosted values: r604800 = past week, r2592000 = past month, '' = any time. Optional array inputs: remote ['1' on-site,'2' remote,'3' hybrid], experienceLevel ['1'..'6' Internship..Executive], contractType ['F','P','C','T','I','O']. Each search's `limit` caps results (and cost). A failing/empty actor is logged and skipped, never crashes the run.",
        "tokenEnv": "APIFY_TOKEN",
        "maxItemsPerActor": 100,
        "actors": [
          {
            "actorId": "valig~linkedin-jobs-scraper",
            "label": "linkedin-sr-data-eng-us-24h",
            "source": "linkedin",
            "input": {
              "title": "Senior Data Engineer",
              "location": "United States",
              "datePosted": "r86400",
              "limit": 50
