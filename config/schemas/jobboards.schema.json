{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jobboards.schema.json",
  "title": "Job board / connector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaults",
    "sources"
  ],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rateLimitMs",
        "maxRetries"
      ],
      "properties": {
        "rateLimitMs": {
          "type": "integer",
          "minimum": 0
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "sourceConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many independent sources to run in parallel."
        },
        "boardConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many boards/tenants/companies one adapter fetches in parallel."
        },
        "pageConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many paginated list pages a single tenant fetches in parallel (Workday)."
        },
        "detailConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many per-job detail requests run in parallel per tenant (Workday)."
        },
        "actorConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many Apify actors run in parallel."
        },
        "hostConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many requests may be in flight against ONE host (for Workday, one shared pod like wd5.myworkdayjobs.com) across every source. This is the ceiling the server actually enforces: many boards/tenants share a single host, so the per-source ceilings above cannot prevent a 429 on their own."
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "adapter",
          "enabled",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "enum": [
              "manualUrls",
              "dice",
              "indeed",
              "linkedin",
              "greenhouse",
              "lever",
              "workday",
              "careers",
              "genericPublicPage",
              "apify",
              "ashby",
              "smartrecruiters"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "rateLimitMs": {
            "type": "integer",
            "minimum": 0
          },
          "hostConcurrency": {
            "type": "integer",
            "minimum": 1,
            "description": "Optional per-source in-flight ceiling when the adapter creates its own host gate."
          },
          "hostSpacingMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Minimum delay between request starts against one physical host/pod."
          },
          "maxDetailFetches": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum optional Workday full-description requests per tenant; cached descriptions do not consume this budget."
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "boards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "host",
                "tenant",
                "site"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "tenant": {
                  "type": "string",
                  "minLength": 1
                },
                "site": {
                  "type": "string",
                  "minLength": 1
                },
                "locale": {
                  "type": "string"
                },
                "pageSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "searchText": {
                  "type": "string"
                }
              }
            }
          },
          "maxLinksPerCompany": {
            "type": "integer",
            "minimum": 1
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ats": {
                  "type": "string",
                  "enum": [
                    "greenhouse",
                    "lever",
                    "workday"
                  ]
                },
                "slug": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "tenant": {
                  "type": "string"
                },
                "site": {
                  "type": "string"
                },
                "locale": {
                  "type": "string"
                },
                "pageSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "searchText": {
                  "type": "string"
                },
                "careersUrl": {
                  "type": "string"
                },
                "sitemap": {
                  "type": "string"
                }
              }
            }
          },
          "options": {
            "type": "object"
          }
        }
      }
    }
  }
}
