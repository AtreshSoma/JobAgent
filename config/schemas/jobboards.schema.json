{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "jobboards.schema.json",
  "title": "Job board / connector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaults", "sources"],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rateLimitMs", "maxRetries"],
      "properties": {
        "rateLimitMs": { "type": "integer", "minimum": 0 },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "requestTimeoutMs": { "type": "integer", "minimum": 0 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "enabled", "priority"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapter": {
            "type": "string",
            "enum": [
              "manualUrls",
              "dice",
              "indeed",
              "linkedin",
              "greenhouse",
              "lever",
              "workday",
              "careers",
              "genericPublicPage",
              "apify"
            ]
          },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 1 },
          "rateLimitMs": { "type": "integer", "minimum": 0 },
          "queries": { "type": "array", "items": { "type": "string" } },
          "urls": { "type": "array", "items": { "type": "string" } },
          "boards": { "type": "array", "items": { "type": "string" } },
          "tenants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["host", "tenant", "site"],
              "properties": {
                "host": { "type": "string", "minLength": 1 },
                "tenant": { "type": "string", "minLength": 1 },
                "site": { "type": "string", "minLength": 1 },
                "locale": { "type": "string" },
                "pageSize": { "type": "integer", "minimum": 1 },
                "searchText": { "type": "string" }
              }
            }
          },
          "maxLinksPerCompany": { "type": "integer", "minimum": 1 },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "ats": { "type": "string", "enum": ["greenhouse", "lever", "workday"] },
                "slug": { "type": "string" },
                "token": { "type": "string" },
                "host": { "type": "string" },
                "tenant": { "type": "string" },
                "site": { "type": "string" },
                "locale": { "type": "string" },
                "pageSize": { "type": "integer", "minimum": 1 },
                "searchText": { "type": "string" },
                "careersUrl": { "type": "string" },
                "sitemap": { "type": "string" }
              }
            }
          },
          "options": { "type": "object" }
        }
      }
    }
  }
}
