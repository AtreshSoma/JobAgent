{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scoring.schema.json",
  "title": "Scoring configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "weights",
    "tiers",
    "keywords",
    "sponsorshipGate"
  ],
  "properties": {
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-category point ceilings. Sum is the maximum achievable raw score.",
      "required": [
        "titleFit",
        "seniorityFit",
        "azureFabricStack",
        "dataEngineeringStack",
        "biSemanticDepth",
        "pythonSqlPyspark",
        "domainFit",
        "sponsorshipFeasibility",
        "geographyFit",
        "freshness",
        "directAtsAvailability",
        "companySponsorshipLikelihood",
        "resumeKeywordAlignment"
      ],
      "properties": {
        "titleFit": {
          "type": "number",
          "minimum": 0
        },
        "seniorityFit": {
          "type": "number",
          "minimum": 0
        },
        "azureFabricStack": {
          "type": "number",
          "minimum": 0
        },
        "dataEngineeringStack": {
          "type": "number",
          "minimum": 0
        },
        "biSemanticDepth": {
          "type": "number",
          "minimum": 0
        },
        "pythonSqlPyspark": {
          "type": "number",
          "minimum": 0
        },
        "domainFit": {
          "type": "number",
          "minimum": 0
        },
        "sponsorshipFeasibility": {
          "type": "number",
          "minimum": 0
        },
        "geographyFit": {
          "type": "number",
          "minimum": 0
        },
        "freshness": {
          "type": "number",
          "minimum": 0
        },
        "directAtsAvailability": {
          "type": "number",
          "minimum": 0
        },
        "companySponsorshipLikelihood": {
          "type": "number",
          "minimum": 0
        },
        "resumeKeywordAlignment": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lower-bound score (0-100 normalized) for each tier.",
      "required": [
        "priority",
        "apply",
        "queue",
        "nearMiss"
      ],
      "properties": {
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "apply": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "queue": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "nearMiss": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titles",
        "azureFabric",
        "dataEngineering",
        "biSemantic",
        "languages",
        "domains"
      ],
      "properties": {
        "titles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "azureFabric": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataEngineering": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "biSemantic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devopsInfra": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional. Folded into dataEngineeringStack's matched pool (see scorer.js) rather than given its own weight — widens which terms can satisfy the existing cap instead of reallocating the score budget."
        },
        "dataQuality": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional. Folded into dataEngineeringStack's matched pool, same reasoning as devopsInfra."
        },
        "genAI": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional. Folded into dataEngineeringStack's matched pool, same reasoning as devopsInfra."
        }
      }
    },
    "sponsorshipGate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sponsorship statuses that permit a job to reach Apply/Priority tiers.",
      "required": [
        "allowApplyWhen"
      ],
      "properties": {
        "allowApplyWhen": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Confirmed",
              "Likely",
              "Approved"
            ]
          },
          "minItems": 1
        }
      }
    },
    "sponsorship": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inputs for the sponsorship classifier.",
      "properties": {
        "affirmativePhrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "likelySponsors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skipOlderThanDays": {
          "type": "integer",
          "minimum": 1
        },
        "flagOlderThanDays": {
          "type": "integer",
          "minimum": 1
        },
        "highApplicantThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceAliases": {
      "type": "object",
      "description": "JD term -> profile terms that truthfully evidence it (skill-alias ontology). A JD keyword is only reported as a gap when neither it nor any alias appears in the candidate profile.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "saturation": {
      "type": "object",
      "description": "How many distinct keyword hits earn FULL marks for each scoring category (points = weight * min(1, matched / fullAt)). Higher values reward depth over mere presence. titleFit is binary by design.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "categories": {
      "type": "array",
      "description": "Declarative keyword-scoring categories. Replaces the six hardcoded ones, which owned 64 of 110 points and could only be earned by one data-engineering vocabulary. Omit this array entirely to fall back to the legacy weights/keywords shape unchanged.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "fullAt": {
            "type": "integer",
            "minimum": 1,
            "description": "Distinct term hits that earn full marks. Higher rewards depth over presence."
          },
          "match": {
            "enum": [
              "title",
              "text"
            ],
            "description": "'title' matches the job title only; 'text' matches title + description."
          },
          "from": {
            "enum": [
              "targetTitles",
              "technicalStack"
            ],
            "description": "Draw terms from the PROFILE, so editing candidate.json changes scoring."
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "An explicit inline term list."
          },
          "keywordSet": {
            "description": "Name (or names) of a list under scoring.keywords.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    }
  },
  "patternProperties": {
    "^_": {
      "type": "string"
    }
  }
}
