{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first automated job search, resume tailoring, and human-approved application assistant.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "app": "node src/index.js app",
    "start": "node src/index.js go",
    "go": "node src/index.js go",
    "dashboard": "node src/index.js dashboard",
    "ui": "node src/index.js dashboard",
    "doctor": "node src/index.js doctor",
    "preflight": "node src/index.js doctor",
    "find": "node src/index.js prepare-apps",
    "discover": "node src/index.js discover",
    "score": "node src/index.js score",
    "prepare-apps": "node src/index.js prepare-apps",
    "assist": "node src/index.js assist",
    "apply": "node src/index.js apply",
    "watch": "node src/index.js watch",
    "end-to-end": "node src/index.js end-to-end",
    "approvals": "node src/index.js approvals",
    "approve": "node src/index.js approve",
    "reject": "node src/index.js reject",
    "packets": "node src/index.js packets",
    "packet": "node src/index.js packet",
    "tracker": "node scripts/tracker.mjs",
    "learn": "node interview-prep/serve.mjs",
    "prep": "node interview-prep/serve.mjs",
    "prep:pdf": "node interview-prep/build-pdf.mjs",
    "dry-run": "node src/index.js --mode=DRY_RUN",
    "live-assist": "node src/index.js --mode=LIVE_ASSIST",
    "report": "node src/index.js --report",
    "migrate-output-names": "node scripts/migrateOutputNames.js",
    "cleanup-outputs": "node scripts/cleanupGeneratedOutputs.js",
    "regenerate-resumes": "node scripts/regenerateResumes.js",
    "audit:resumes": "node scripts/auditTailoredResumes.js --limit=3",
    "verify": "node scripts/verifyRepoHealth.js",
    "db:maintenance": "node scripts/dbMaintenance.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python -m pytest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "playwright": "~1.56.1"
  },
  "devDependencies": {
    "marked": "^18.0.6",
    "vitest": "^4.1.10"
  }
}
